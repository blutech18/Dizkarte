# Dizkarte — root environment example (SAFE placeholders only).
# Copy to `.env` for local development. NEVER commit real secrets.
# Production/staging values live only in managed server environments.

# development | test | staging | production
DIZKARTE_ENV=development

# --- Supabase (public, client-safe) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Adapter modes: synthetic | sandbox | live ---
# Synthetic is deterministic and NEVER allowed in production.
PAYMENT_MODE=synthetic
MAP_MODE=synthetic
PUSH_MODE=synthetic
MEDIA_MODE=synthetic
MONITORING_MODE=synthetic

# --- Public provider identifiers (restricted keys only) ---
MAP_PUBLIC_KEY=

# --- SERVER-ONLY SECRETS (never in client/mobile bundles) ---
# Required in staging/production. Leave blank for synthetic development.
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PUSH_CREDENTIALS=
MONITORING_DSN=
