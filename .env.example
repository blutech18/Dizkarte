# Dizkarte — root environment example (SAFE placeholders only).
# Copy to `.env` for local development. NEVER commit real secrets.
# Production/staging values live only in managed server environments.

# development | test | staging | production
DIZKARTE_ENV=development

# --- Supabase (public, client-safe) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Adapter modes: synthetic | sandbox | live ---
# Synthetic is deterministic and NEVER allowed in production.
PAYMENT_MODE=synthetic
MAP_MODE=synthetic
PUSH_MODE=synthetic
MEDIA_MODE=synthetic
MONITORING_MODE=synthetic

# --- Public provider identifiers (restricted keys only) ---
MAP_PUBLIC_KEY=

# --- SERVER-ONLY SECRETS (never in client/mobile bundles) ---
# Required in staging/production. Leave blank for synthetic development.
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PUSH_CREDENTIALS=
MONITORING_DSN=

# --- Payment webhook signature (edge function only; optional, sane defaults) ---
# How the chosen provider signs webhooks. The payment-webhook function verifies
# the signature in live/sandbox mode using these.
#   PAYMENT_WEBHOOK_SIGNATURE_SCHEME:
#     hmac_sha256_timestamped (default) — `t=<unix>,v1=<hex>` style
#     hmac_sha256_hex                   — bare HMAC-SHA256 hex digest of the body
#     static_token                      — a constant shared verification token,
#                                         compared in constant time (this is what
#                                         Xendit's `x-callback-token` is; it is NOT
#                                         an HMAC of the body)
#   PAYMENT_WEBHOOK_SIGNATURE_HEADER: request header carrying the signature (default x-signature)
#   PAYMENT_WEBHOOK_TOLERANCE_SECONDS: replay window for the timestamped scheme (default 300)
# Confirm the exact scheme and header name against the approved provider's docs.
#
# Xendit sandbox example (secrets themselves belong in `.env`, never here):
#   PAYMENT_PROVIDER=xendit
#   PAYMENT_WEBHOOK_SIGNATURE_SCHEME=static_token
#   PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-callback-token
PAYMENT_WEBHOOK_SIGNATURE_SCHEME=
PAYMENT_WEBHOOK_SIGNATURE_HEADER=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=
