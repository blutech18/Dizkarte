# Dizkarte seed-script credentials (SERVICE-ROLE — never commit real values).
#
# Copy this file to `.env.seed` (git-ignored) and fill in the values from your
# Supabase project: Project Settings → API. Then run:
#
#   npm run seed:supabase
#
# The service-role key bypasses Row Level Security and must ONLY be used by
# this server-side script — never in the mobile or admin app bundles.
#
# The development account roster and their shared password are NOT configured
# here. They live in packages/config/src/dev/dev-accounts.json, which the seeder,
# the Admin login page, and the mobile sign-in screen all read, so the
# credentials the apps display can never drift from the ones provisioned.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
