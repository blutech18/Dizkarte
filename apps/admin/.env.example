# Dizkarte Admin (Next.js) — environment example (SAFE placeholders only).
# Server-only secrets are read on the server and MUST NOT be prefixed with
# NEXT_PUBLIC_. Only NEXT_PUBLIC_ values reach the browser bundle.

DIZKARTE_ENV=development

# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_PAYMENT_MODE=synthetic
NEXT_PUBLIC_MAP_MODE=synthetic
NEXT_PUBLIC_MAP_PUBLIC_KEY=

# Server-only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=
PAYMENT_WEBHOOK_SECRET=
MONITORING_DSN=

# Admin data source. Leave unset (the default) to read and write the real
# Supabase project through the signed-in Admin's own JWT with RLS enforced.
# Set to "synthetic" ONLY for offline development against deterministic
# in-memory fixtures; it is rejected outside development/test so staging and
# production can never be served fabricated data.
# ADMIN_DATA_ADAPTER=synthetic

# Optional. Absolute origin used to build the password-reset link emailed to
# Admins (e.g. https://admin.dizkarte.example). Leave unset to derive it from
# the incoming request; set it when running behind a proxy whose forwarded
# headers should not be trusted. Whichever value is used must also be
# allow-listed under Supabase > Authentication > URL Configuration.
# ADMIN_SITE_URL=
