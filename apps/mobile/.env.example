# Dizkarte Mobile (Expo) — environment example (SAFE placeholders only).
# Expo inlines EXPO_PUBLIC_ values into the app bundle. NEVER put service-role
# or provider secrets here — the mobile bundle only receives publishable keys.

DIZKARTE_ENV=development
# Expo only inlines EXPO_PUBLIC_* into the bundle, so the environment must also
# be exposed under this prefixed key or the app fails closed on startup.
EXPO_PUBLIC_DIZKARTE_ENV=development

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_PAYMENT_MODE=synthetic
EXPO_PUBLIC_MAP_MODE=synthetic
EXPO_PUBLIC_PUSH_MODE=synthetic
EXPO_PUBLIC_MEDIA_MODE=synthetic
EXPO_PUBLIC_MAP_PUBLIC_KEY=

# Optional social login (off by default). Set to "true" ONLY after the Google
# provider is configured in the Supabase dashboard (Auth > Providers) and the
# app's redirect URL (dizkarte://) is allow-listed. When unset/false, the
# "Continue with Google" button is hidden entirely.
EXPO_PUBLIC_AUTH_GOOGLE=false

# Marketplace data source. Leave unset (the default) to read and write the real
# Supabase project through the signed-in user's own JWT with RLS enforced.
# Set to "synthetic" ONLY for offline development against the deterministic
# in-memory dataset; it is rejected outside development/test so staging and
# production can never be served fabricated marketplace data.
# EXPO_PUBLIC_MARKETPLACE_ADAPTER=synthetic
