{
  "expo": {
    "name": "Dizkarte",
    "slug": "dizkarte",
    "scheme": "dizkarte",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-icon-square.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dizkarte.mobile"
    },
    "android": {
      "package": "com.dizkarte.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-square.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dizkarte uses your location to set your task's pickup and drop-off addresses."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dizkarte uses your photo library so you can attach real task photos.",
          "cameraPermission": "Dizkarte uses your camera so you can photograph the task area.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
